from snakemake.utils import min_version, validate

min_version("7.32.0")

# Fail fast with a clear message if the config is missing/misnamed keys, rather
# than deep inside a rule. Schema in workflow/schemas/config.schema.yaml.
validate(config, "schemas/config.schema.yaml")

deps = config["deps"]
outs = config["outs"]


# Single helper, defined inline — this workflow is small enough that a separate
# rules/common.smk would be ceremony. As it grows, move shared helpers there.
def gene_extra_inputs():
    """Optional extra inputs for the gene_h5ad rule.

    The clinical obs-join is optional: include deps.clinical in the DAG only when a
    `params.clinical` block is configured, so the workflow also runs for cohorts
    without a clinical table.
    """
    params = config.get("params") or {}
    if params.get("clinical"):
        return [config["deps"]["clinical"]]
    return []


# Every rule runs the same generic shim, workflow/scripts/_run.py, which calls
# dispatch_by_rule(): it maps snakemake.rule -> bulk_rna_preprocessing._steps.<rule>.run
# and binds that step's typed run() parameters from the rule's input/output (matched
# by name) and from config. So the rule *name* is the pointer to the code
# (rule `gene` -> _steps/gene.py), the heavy logic stays in the library, and there
# are no per-rule shim files. The shim puts src/ on sys.path itself (from
# snakemake.scriptdir), since the package is not installed into the --use-conda env.
rule all:
    input:
        outs["gene_h5ad"],
        outs["transcript_h5ad"],


rule gene_annotation:
    """GENCODE GTF -> gene-level annotation TSV (gene_id, gene_name, gene_type, hgnc_id)."""
    input:
        gencode_gtf=deps["gencode_gtf"],
    output:
        gene_annotation=outs["gene_annotation"],
    log:
        "logs/bulk-rna-preprocessing/gene_annotation.log",
    # absconda: replaced conda env with container
    # conda:
    # "../env/environment.yaml"
    container:
        "docker://ghcr.io/swarbricklab/bulk-rna-preprocessing@sha256:4d92c05f24d0147f06a9631f52fde2ed26bf8c3d27f106c7bb09f6cb9c184e05"
    # step:
    #   src/bulk_rna_preprocessing/_steps/gene_annotation.py
    script:
        "scripts/_run.py"


rule gene:
    """Aggregate gene-level Salmon quants -> annotated, UQN-normalised gene_counts.h5ad."""
    input:
        gene_annotation=outs["gene_annotation"],
        counts_dir=deps["counts_dir"],
        samplesheet=deps["samplesheet"],
        hgnc_complete_set=deps["hgnc_complete_set"],
        # DAG dependency only when a clinical obs-join is configured; the gene step
        # reads the clinical path from config, so this has no matching run() param.
        clinical=gene_extra_inputs(),
    output:
        gene_h5ad=outs["gene_h5ad"],
    log:
        "logs/bulk-rna-preprocessing/gene.log",
    # absconda: replaced conda env with container
    # conda:
    # "../env/environment.yaml"
    container:
        "docker://ghcr.io/swarbricklab/bulk-rna-preprocessing@sha256:4d92c05f24d0147f06a9631f52fde2ed26bf8c3d27f106c7bb09f6cb9c184e05"
    # step:
    #   src/bulk_rna_preprocessing/_steps/gene.py
    script:
        "scripts/_run.py"


rule transcript:
    """Aggregate transcript-level Salmon quants -> transcript_counts.h5ad (no annotation/UQN)."""
    input:
        counts_dir=deps["counts_dir"],
        samplesheet=deps["samplesheet"],
    output:
        transcript_h5ad=outs["transcript_h5ad"],
    log:
        "logs/bulk-rna-preprocessing/transcript.log",
    # absconda: replaced conda env with container
    # conda:
    # "../env/environment.yaml"
    container:
        "docker://ghcr.io/swarbricklab/bulk-rna-preprocessing@sha256:4d92c05f24d0147f06a9631f52fde2ed26bf8c3d27f106c7bb09f6cb9c184e05"
    # step:
    #   src/bulk_rna_preprocessing/_steps/transcript.py
    script:
        "scripts/_run.py"
