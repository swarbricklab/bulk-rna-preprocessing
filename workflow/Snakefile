from pathlib import Path

from snakemake.utils import min_version, validate

min_version("7.32.0")

# Fail fast with a clear message if the config is missing/misnamed keys, rather
# than deep inside a rule. Schema in workflow/schemas/config.schema.yaml.
validate(config, "schemas/config.schema.yaml")

deps = config["deps"]
outs = config["outs"]

# src/ dir of the bulk_rna_preprocessing package (src/ layout). Each rule passes
# this as params.pkg_src so the shim can put it on sys.path from inside the job:
# Snakemake scrubs PYTHONPATH for --use-conda jobs, and the package is not
# pip-installed into the per-rule env.
PKG_SRC = str((Path(workflow.basedir).parent / "src").resolve())


include: "rules/common.smk"


# Each rule runs a 3-line scripts/*.py shim that calls dispatch(run, globals()):
# the bulk_rna_preprocessing._dispatch dispatcher binds the step's typed run()
# parameters from these input/output/params namespaces (matched by name) and from
# config, so the heavy logic stays in the installable library. The package is put
# on PYTHONPATH by run.sh / run_test.sh (src/ layout); the conda env supplies the
# scientific deps.
rule all:
    input:
        outs["gene_h5ad"],
        outs["transcript_h5ad"],


rule gene_annotation:
    """GENCODE GTF -> gene-level annotation TSV (gene_id, gene_name, gene_type, hgnc_id)."""
    input:
        gencode_gtf=deps["gencode_gtf"],
    output:
        gene_annotation=outs["gene_annotation"],
    params:
        pkg_src=PKG_SRC,
    conda:
        "../env/environment.yaml"
    log:
        "logs/bulk-rna-preprocessing/gene_annotation.log",
    script:
        "scripts/gene_annotation.py"


rule gene_h5ad:
    """Aggregate gene-level Salmon quants -> annotated, UQN-normalised gene_counts.h5ad."""
    input:
        gene_annotation=outs["gene_annotation"],
        counts_dir=deps["counts_dir"],
        samplesheet=deps["samplesheet"],
        hgnc_complete_set=deps["hgnc_complete_set"],
        # DAG dependency only when a clinical obs-join is configured; the gene step
        # reads the clinical path from config, so this has no matching run() param.
        clinical=gene_extra_inputs(),
    output:
        gene_h5ad=outs["gene_h5ad"],
    params:
        pkg_src=PKG_SRC,
    conda:
        "../env/environment.yaml"
    log:
        "logs/bulk-rna-preprocessing/gene_h5ad.log",
    script:
        "scripts/gene.py"


rule transcript_h5ad:
    """Aggregate transcript-level Salmon quants -> transcript_counts.h5ad (no annotation/UQN)."""
    input:
        counts_dir=deps["counts_dir"],
        samplesheet=deps["samplesheet"],
    output:
        transcript_h5ad=outs["transcript_h5ad"],
    params:
        pkg_src=PKG_SRC,
    conda:
        "../env/environment.yaml"
    log:
        "logs/bulk-rna-preprocessing/transcript_h5ad.log",
    script:
        "scripts/transcript.py"
